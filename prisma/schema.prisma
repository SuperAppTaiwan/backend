generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "mongodb"
  url          = env("MONGODB_URL")
  relationMode = "prisma"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserStatus {
  ACTIVE
  INACTIVE
  BANNED
}

enum EventStatus {
  PENDING
  PROCESSED
  FAILED
}

// Finance enums
enum IncomeSourceType {
  SALARY
  TUTORING
  FAMILY
  SCHOLARSHIP
  FREELANCE
  OTHER
}

enum ExpenseCategoryType {
  RENT
  FOOD
  TRANSPORTATION
  UTILITIES
  INSURANCE
  EDUCATION
  ENTERTAINMENT
  HEALTH
  SHOPPING
  OTHER
}

enum PaymentMethod {
  CASH
  CARD
  BANK
  EWALLET
  OTHER
}

// Goal enums
enum GoalType {
  CAR
  EMERGENCY_FUND
  HSK
  SAVINGS
  STUDY
  CUSTOM
}

enum GoalPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum GoalStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum GoalRiskLevel {
  LOW
  MEDIUM
  HIGH
}

// Learning enums
enum VocabularyStatus {
  NEW
  LEARNING
  LEARNED
  REVIEW
}

enum LearningPlanStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum ReviewResult {
  AGAIN
  HARD
  GOOD
  EASY
}

// Schedule enums
enum FixedEventType {
  CLASS
  WORK
  STUDY
  PERSONAL
  ADMINISTRATIVE
  GENERAL
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
  CANCELLED
  OVERDUE
}

// AI enums
enum AISuggestionType {
  FINANCE
  GOAL
  LEARNING
  SCHEDULE
  NUTRITION
  LIFESTYLE
  HEALTH
  SYSTEM
}

// Food enums
enum FoodCategory {
  VEGETABLE
  FRUIT
  MEAT
  SEAFOOD
  DAIRY
  GRAIN
  LEGUME
  CONDIMENT
  BEVERAGE
  SNACK
  FROZEN
  OTHER
}

enum UnitOfMeasure {
  GRAM
  KG
  ML
  LITER
  PIECE
  PACK
  CAN
  BOTTLE
  BOX
  TABLESPOON
  TEASPOON
  CUP
  OTHER
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

enum ShoppingListStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

// Knowledge enums
enum KnowledgeCategory {
  LEGAL
  HEALTHCARE
  HOUSING
  BANKING
  TRANSPORTATION
  FOOD_CULTURE
  EDUCATION
  EMPLOYMENT
  EMERGENCY
  GENERAL
}

enum KnowledgeDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum AISuggestionPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum AISuggestionStatus {
  ACTIVE
  DISMISSED
  ACCEPTED
  EXPIRED
}

// Notification enums
enum NotificationType {
  TASK_REMINDER
  GOAL_REMINDER
  BUDGET_WARNING
  DAILY_VOCABULARY
  MEAL_PREPARATION
  INGREDIENT_EXPIRY
  HSK_STUDY
  ARC_RENEWAL
  INSURANCE_RENEWAL
  WEEKLY_SUMMARY
  SYSTEM
}

enum PushPlatform {
  IOS
  ANDROID
  WEB
}

enum NotificationStatus {
  UNREAD
  READ
  ARCHIVED
  SENT
  FAILED
}

// ─── User ────────────────────────────────────────────────────────────────────

model User {
  id           String     @id @default(cuid()) @map("_id")
  email        String     @unique
  passwordHash String     @map("password_hash")
  displayName  String     @map("display_name")
  avatarUrl    String?    @map("avatar_url")
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  profile                UserProfile?
  refreshTokens          RefreshToken[]
  events                 Event[]
  incomeSources          IncomeSource[]
  incomes                Income[]
  expenseCategories      ExpenseCategory[]
  expenses               Expense[]
  budgets                Budget[]
  goals                  Goal[]
  goalMilestones         GoalMilestone[]
  goalForecasts          GoalForecast[]
  vocabProgress          UserVocabularyProgress[]
  learningPlans          LearningPlan[]
  reviewSessions         ReviewSession[]
  fixedEvents            FixedEvent[]
  tasks                  Task[]
  schedulePlans          SchedulePlan[]
  aiProfile              AIProfile?
  aiSuggestions          AISuggestion[]
  recommendationLogs     RecommendationLog[]
  notifications          Notification[]
  notificationPreference NotificationPreference?
  ingredients            Ingredient[]
  recipes                Recipe[]
  mealPlans              MealPlan[]
  shoppingLists          ShoppingList[]
  knowledgeArticles      KnowledgeArticle[]
  knowledgeBookmarks     KnowledgeBookmark[]
  pushTokens             PushToken[]
  conversations          Conversation[]

  @@map("users")
}

model UserProfile {
  id                   String   @id @default(cuid()) @map("_id")
  userId               String   @unique @map("user_id")
  locationCity         String?  @map("location_city")
  timezone             String   @default("Asia/Taipei")
  currency             String   @default("TWD")
  monthlyBudget        Float?   @map("monthly_budget")
  chineseLevel         String?  @map("chinese_level")
  dietPreference       String?  @map("diet_preference")
  livingStatus         String?  @map("living_status")
  familySupportMonthly Float?   @map("family_support_monthly")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model RefreshToken {
  id        String    @id @default(cuid()) @map("_id")
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

// ─── Event Store ─────────────────────────────────────────────────────────────

model Event {
  id           String      @id @default(cuid()) @map("_id")
  userId       String?     @map("user_id")
  eventType    String      @map("event_type")
  sourceModule String      @map("source_module")
  payloadJson  Json        @map("payload_json")
  status       EventStatus @default(PENDING)
  processedAt  DateTime?   @map("processed_at")
  createdAt    DateTime    @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("events")
}

// ─── Finance ─────────────────────────────────────────────────────────────────

model IncomeSource {
  id             String           @id @default(cuid()) @map("_id")
  userId         String           @map("user_id")
  name           String
  type           IncomeSourceType
  expectedAmount Float            @map("expected_amount")
  currency       String           @default("TWD")
  isActive       Boolean          @default(true) @map("is_active")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  incomes Income[]

  @@map("income_sources")
}

model Income {
  id           String   @id @default(cuid()) @map("_id")
  userId       String   @map("user_id")
  sourceId     String?  @map("source_id")
  amount       Float
  currency     String   @default("TWD")
  receivedDate DateTime @map("received_date")
  note         String?
  eventId      String?  @map("event_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  source IncomeSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@map("incomes")
}

model ExpenseCategory {
  id        String              @id @default(cuid()) @map("_id")
  userId    String?             @map("user_id")
  name      String
  type      ExpenseCategoryType
  isDefault Boolean             @default(false) @map("is_default")
  createdAt DateTime            @default(now()) @map("created_at")
  updatedAt DateTime            @updatedAt @map("updated_at")

  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  expenses Expense[]

  @@map("expense_categories")
}

model Expense {
  id             String        @id @default(cuid()) @map("_id")
  userId         String        @map("user_id")
  categoryId     String?       @map("category_id")
  amount         Float
  currency       String        @default("TWD")
  expenseDate    DateTime      @map("expense_date")
  paymentMethod  PaymentMethod @map("payment_method")
  sourceModule   String        @default("manual") @map("source_module")
  sourceEntityId String?       @map("source_entity_id")
  note           String?
  eventId        String?       @map("event_id")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  category ExpenseCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@map("expenses")
}

model Budget {
  id                 String   @id @default(cuid()) @map("_id")
  userId             String   @map("user_id")
  month              Int
  year               Int
  totalLimit         Float    @map("total_limit")
  currency           String   @default("TWD")
  categoryLimitsJson Json?    @map("category_limits_json")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month, year])
  @@map("budgets")
}

// ─── Goals ───────────────────────────────────────────────────────────────────

model Goal {
  id            String       @id @default(cuid()) @map("_id")
  userId        String       @map("user_id")
  goalType      GoalType     @map("goal_type")
  title         String
  targetAmount  Float?       @map("target_amount")
  currentAmount Float        @default(0) @map("current_amount")
  targetDate    DateTime?    @map("target_date")
  priority      GoalPriority @default(MEDIUM)
  status        GoalStatus   @default(ACTIVE)
  metadataJson  Json?        @map("metadata_json")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  milestones GoalMilestone[]
  forecasts  GoalForecast[]

  @@map("goals")
}

model GoalMilestone {
  id           String    @id @default(cuid()) @map("_id")
  goalId       String    @map("goal_id")
  userId       String    @map("user_id")
  title        String
  targetAmount Float?    @map("target_amount")
  targetDate   DateTime? @map("target_date")
  isCompleted  Boolean   @default(false) @map("is_completed")
  completedAt  DateTime? @map("completed_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("goal_milestones")
}

model GoalForecast {
  id                    String        @id @default(cuid()) @map("_id")
  goalId                String        @map("goal_id")
  userId                String        @map("user_id")
  requiredMonthlySaving Float?        @map("required_monthly_saving")
  currentMonthlySaving  Float?        @map("current_monthly_saving")
  probability           Int
  riskLevel             GoalRiskLevel @map("risk_level")
  forecastDate          DateTime      @default(now()) @map("forecast_date")
  aiReason              String?       @map("ai_reason")
  createdAt             DateTime      @default(now()) @map("created_at")

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("goal_forecasts")
}

// ─── Learning ────────────────────────────────────────────────────────────────

model Vocabulary {
  id                 String   @id @default(cuid()) @map("_id")
  traditional        String
  simplified         String
  pinyin             String
  meaningVi          String   @map("meaning_vi")
  meaningEn          String?  @map("meaning_en")
  exampleTraditional String?  @map("example_traditional")
  exampleSimplified  String?  @map("example_simplified")
  examplePinyin      String?  @map("example_pinyin")
  exampleMeaningVi   String?  @map("example_meaning_vi")
  hskLevel           Int?     @map("hsk_level")
  topic              String?
  source             String   @default("system")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  userProgress   UserVocabularyProgress[]
  reviewSessions ReviewSession[]

  @@map("vocabularies")
}

model UserVocabularyProgress {
  id             String           @id @default(cuid()) @map("_id")
  userId         String           @map("user_id")
  vocabularyId   String           @map("vocabulary_id")
  status         VocabularyStatus @default(NEW)
  familiarity    Int              @default(0)
  reviewCount    Int              @default(0) @map("review_count")
  lastReviewedAt DateTime?        @map("last_reviewed_at")
  nextReviewAt   DateTime?        @map("next_review_at")
  learnedAt      DateTime?        @map("learned_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  vocabulary Vocabulary @relation(fields: [vocabularyId], references: [id], onDelete: Cascade)

  @@unique([userId, vocabularyId])
  @@map("user_vocabulary_progress")
}

model LearningPlan {
  id              String             @id @default(cuid()) @map("_id")
  userId          String             @map("user_id")
  title           String
  targetLevel     String?            @map("target_level")
  dailyWordTarget Int                @default(2) @map("daily_word_target")
  startDate       DateTime           @map("start_date")
  endDate         DateTime?          @map("end_date")
  status          LearningPlanStatus @default(ACTIVE)
  metadataJson    Json?              @map("metadata_json")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("learning_plans")
}

model ReviewSession {
  id           String       @id @default(cuid()) @map("_id")
  userId       String       @map("user_id")
  vocabularyId String?      @map("vocabulary_id")
  result       ReviewResult
  reviewedAt   DateTime     @default(now()) @map("reviewed_at")
  score        Int?
  note         String?
  createdAt    DateTime     @default(now()) @map("created_at")

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  vocabulary Vocabulary? @relation(fields: [vocabularyId], references: [id], onDelete: SetNull)

  @@map("review_sessions")
}

// ─── Schedule ────────────────────────────────────────────────────────────────

model FixedEvent {
  id             String         @id @default(cuid()) @map("_id")
  userId         String         @map("user_id")
  title          String
  description    String?
  location       String?
  startTime      DateTime       @map("start_time")
  endTime        DateTime       @map("end_time")
  timezone       String         @default("Asia/Taipei")
  recurrenceRule String?        @map("recurrence_rule")
  eventType      FixedEventType @default(GENERAL) @map("event_type")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("fixed_events")
}

model Task {
  id               String       @id @default(cuid()) @map("_id")
  userId           String       @map("user_id")
  title            String
  description      String?
  priority         TaskPriority @default(MEDIUM)
  status           TaskStatus   @default(TODO)
  deadline         DateTime?
  estimatedMinutes Int?         @map("estimated_minutes")
  scheduledStart   DateTime?    @map("scheduled_start")
  scheduledEnd     DateTime?    @map("scheduled_end")
  sourceModule     String       @default("manual") @map("source_module")
  sourceEntityId   String?      @map("source_entity_id")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("tasks")
}

model SchedulePlan {
  id        String   @id @default(cuid()) @map("_id")
  userId    String   @map("user_id")
  planDate  DateTime @map("plan_date")
  summary   String?
  planJson  Json     @map("plan_json")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("schedule_plans")
}

// ─── AI ──────────────────────────────────────────────────────────────────────

model AIProfile {
  id                       String   @id @default(cuid()) @map("_id")
  userId                   String   @unique @map("user_id")
  financialHealthScore     Int      @default(0) @map("financial_health_score")
  learningConsistencyScore Int      @default(0) @map("learning_consistency_score")
  nutritionScore           Int      @default(0) @map("nutrition_score")
  productivityScore        Int      @default(0) @map("productivity_score")
  goalRiskScore            Int      @default(0) @map("goal_risk_score")
  profileJson              Json?    @map("profile_json")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ai_profiles")
}

model AISuggestion {
  id             String               @id @default(cuid()) @map("_id")
  userId         String               @map("user_id")
  type           AISuggestionType
  title          String
  message        String
  priority       AISuggestionPriority @default(MEDIUM)
  sourceModule   String               @map("source_module")
  sourceEntityId String?              @map("source_entity_id")
  status         AISuggestionStatus   @default(ACTIVE)
  metadataJson   Json?                @map("metadata_json")
  createdAt      DateTime             @default(now()) @map("created_at")
  expiresAt      DateTime?            @map("expires_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ai_suggestions")
}

model RecommendationLog {
  id          String   @id @default(cuid()) @map("_id")
  userId      String   @map("user_id")
  requestType String   @map("request_type")
  inputJson   Json?    @map("input_json")
  outputJson  Json?    @map("output_json")
  provider    String   @default("deterministic")
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("recommendation_logs")
}

// ─── Notifications ────────────────────────────────────────────────────────────

model Notification {
  id           String             @id @default(cuid()) @map("_id")
  userId       String             @map("user_id")
  type         NotificationType
  title        String
  message      String
  status       NotificationStatus @default(UNREAD)
  scheduledAt  DateTime?          @map("scheduled_at")
  sentAt       DateTime?          @map("sent_at")
  metadataJson Json?              @map("metadata_json")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model NotificationPreference {
  id              String   @id @default(cuid()) @map("_id")
  userId          String   @unique @map("user_id")
  taskReminder    Boolean  @default(true) @map("task_reminder")
  goalReminder    Boolean  @default(true) @map("goal_reminder")
  budgetWarning   Boolean  @default(true) @map("budget_warning")
  dailyVocabulary Boolean  @default(true) @map("daily_vocabulary")
  weeklySummary   Boolean  @default(true) @map("weekly_summary")
  pushEnabled     Boolean  @default(false) @map("push_enabled")
  emailEnabled    Boolean  @default(false) @map("email_enabled")
  quietHoursStart String?  @map("quiet_hours_start")
  quietHoursEnd   String?  @map("quiet_hours_end")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

// ─── Food ─────────────────────────────────────────────────────────────────────

model Ingredient {
  id                     String        @id @default(cuid()) @map("_id")
  userId                 String        @map("user_id")
  name                   String
  category               FoodCategory  @default(OTHER)
  unit                   UnitOfMeasure @default(PIECE)
  quantity               Float         @default(0)
  expiresAt              DateTime?     @map("expires_at")
  purchasedAt            DateTime?     @map("purchased_at")
  cost                   Float?
  location               String?
  notes                  String?
  sourceType             String        @default("manual") @map("source_type")
  imageUrl               String?       @map("image_url")
  expirySource           String        @default("manual") @map("expiry_source")
  freshnessStatus        String?       @map("freshness_status")
  estimatedDaysRemaining Int?          @map("estimated_days_remaining")
  aiConfidence           Float?        @map("ai_confidence")
  ocrRawText             String?       @map("ocr_raw_text")
  createdAt              DateTime      @default(now()) @map("created_at")
  updatedAt              DateTime      @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ingredients")
}

model Recipe {
  id                 String       @id @default(cuid()) @map("_id")
  userId             String       @map("user_id")
  title              String
  description        String?
  servings           Int          @default(1)
  prepMinutes        Int          @default(0) @map("prep_minutes")
  cookMinutes        Int          @default(0) @map("cook_minutes")
  isPublic           Boolean      @default(false) @map("is_public")
  isAiGenerated      Boolean      @default(false) @map("is_ai_generated")
  category           FoodCategory @default(OTHER)
  ingredientsJson    Json         @map("ingredients_json")
  stepsJson          Json         @map("steps_json")
  tagsJson           Json?        @map("tags_json")
  missingIngredients Json?        @map("missing_ingredients")
  nutritionJson      Json?        @map("nutrition_json")
  aiReason           String?      @map("ai_reason")
  imageUrl           String?      @map("image_url")
  source             String?
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  mealPlans MealPlan[]

  @@map("recipes")
}

model MealPlan {
  id               String   @id @default(cuid()) @map("_id")
  userId           String   @map("user_id")
  planDate         DateTime @map("plan_date")
  mealType         MealType @map("meal_type")
  recipeId         String?  @map("recipe_id")
  customMeal       String?  @map("custom_meal")
  servings         Int      @default(1)
  notes            String?
  isAiGenerated    Boolean  @default(false) @map("is_ai_generated")
  aiReason         String?  @map("ai_reason")
  nutritionSummary String?  @map("nutrition_summary")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe Recipe? @relation(fields: [recipeId], references: [id], onDelete: SetNull)

  @@map("meal_plans")
}

model ShoppingList {
  id        String             @id @default(cuid()) @map("_id")
  userId    String             @map("user_id")
  name      String
  status    ShoppingListStatus @default(ACTIVE)
  notes     String?
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")

  user  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  items ShoppingListItem[]

  @@map("shopping_lists")
}

model ShoppingListItem {
  id             String        @id @default(cuid()) @map("_id")
  shoppingListId String        @map("shopping_list_id")
  ingredientName String        @map("ingredient_name")
  quantity       Float         @default(1)
  unit           UnitOfMeasure @default(PIECE)
  isPurchased    Boolean       @default(false) @map("is_purchased")
  estimatedCost  Float?        @map("estimated_cost")
  notes          String?
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  shoppingList ShoppingList @relation(fields: [shoppingListId], references: [id], onDelete: Cascade)

  @@map("shopping_list_items")
}

// ─── Knowledge ────────────────────────────────────────────────────────────────

model KnowledgeArticle {
  id                   String              @id @default(cuid()) @map("_id")
  authorId             String              @map("author_id")
  title                String
  summary              String
  content              String
  category             KnowledgeCategory   @default(GENERAL)
  difficulty           KnowledgeDifficulty @default(BEGINNER)
  tagsJson             Json?               @map("tags_json")
  estimatedReadMinutes Int                 @default(5) @map("estimated_read_minutes")
  isPublished          Boolean             @default(true) @map("is_published")
  viewCount            Int                 @default(0) @map("view_count")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  author    User                @relation(fields: [authorId], references: [id], onDelete: Cascade)
  bookmarks KnowledgeBookmark[]

  @@map("knowledge_articles")
}

model KnowledgeBookmark {
  id        String   @id @default(cuid()) @map("_id")
  userId    String   @map("user_id")
  articleId String   @map("article_id")
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")

  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  article KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId])
  @@map("knowledge_bookmarks")
}

// ─── AI Conversations ────────────────────────────────────────────────────────

model Conversation {
  id        String   @id @default(cuid()) @map("_id")
  userId    String   @map("user_id")
  title     String   @default("Cuộc trò chuyện")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user     User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ConversationMessage[]

  @@map("conversations")
}

model ConversationMessage {
  id             String   @id @default(cuid()) @map("_id")
  conversationId String   @map("conversation_id")
  role           String
  content        String
  provider       String?  @default("deterministic")
  createdAt      DateTime @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("conversation_messages")
}

// ─── Push Tokens ─────────────────────────────────────────────────────────────

model PushToken {
  id        String       @id @default(cuid()) @map("_id")
  userId    String       @map("user_id")
  token     String
  platform  PushPlatform @default(IOS)
  deviceId  String       @map("device_id")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@map("push_tokens")
}
