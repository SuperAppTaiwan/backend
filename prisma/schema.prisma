generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserStatus {
  ACTIVE
  INACTIVE
  BANNED
}

enum EventStatus {
  PENDING
  PROCESSED
  FAILED
}

// Finance enums
enum IncomeSourceType {
  SALARY
  TUTORING
  FAMILY
  SCHOLARSHIP
  FREELANCE
  OTHER
}

enum ExpenseCategoryType {
  RENT
  FOOD
  TRANSPORTATION
  UTILITIES
  INSURANCE
  EDUCATION
  ENTERTAINMENT
  HEALTH
  SHOPPING
  OTHER
}

enum PaymentMethod {
  CASH
  CARD
  BANK
  EWALLET
  OTHER
}

// Goal enums
enum GoalType {
  CAR
  EMERGENCY_FUND
  HSK
  SAVINGS
  STUDY
  CUSTOM
}

enum GoalPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum GoalStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum GoalRiskLevel {
  LOW
  MEDIUM
  HIGH
}

// ─── User ────────────────────────────────────────────────────────────────────

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String     @map("password_hash")
  displayName  String     @map("display_name")
  avatarUrl    String?    @map("avatar_url")
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  profile           UserProfile?
  refreshTokens     RefreshToken[]
  events            Event[]
  incomeSources     IncomeSource[]
  incomes           Income[]
  expenseCategories ExpenseCategory[]
  expenses          Expense[]
  budgets           Budget[]
  goals             Goal[]
  goalMilestones    GoalMilestone[]
  goalForecasts     GoalForecast[]

  @@map("users")
}

model UserProfile {
  id                   String   @id @default(cuid())
  userId               String   @unique @map("user_id")
  locationCity         String?  @map("location_city")
  timezone             String   @default("Asia/Taipei")
  currency             String   @default("TWD")
  monthlyBudget        Decimal? @map("monthly_budget") @db.Decimal(12, 2)
  chineseLevel         String?  @map("chinese_level")
  dietPreference       String?  @map("diet_preference")
  livingStatus         String?  @map("living_status")
  familySupportMonthly Decimal? @map("family_support_monthly") @db.Decimal(12, 2)
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

// ─── Event Store ─────────────────────────────────────────────────────────────

model Event {
  id           String      @id @default(cuid())
  userId       String?     @map("user_id")
  eventType    String      @map("event_type")
  sourceModule String      @map("source_module")
  payloadJson  Json        @map("payload_json")
  status       EventStatus @default(PENDING)
  processedAt  DateTime?   @map("processed_at")
  createdAt    DateTime    @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("events")
}

// ─── Finance ─────────────────────────────────────────────────────────────────

model IncomeSource {
  id             String           @id @default(cuid())
  userId         String           @map("user_id")
  name           String
  type           IncomeSourceType
  expectedAmount Decimal          @map("expected_amount") @db.Decimal(12, 2)
  currency       String           @default("TWD")
  isActive       Boolean          @default(true) @map("is_active")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  incomes Income[]

  @@map("income_sources")
}

model Income {
  id           String    @id @default(cuid())
  userId       String    @map("user_id")
  sourceId     String?   @map("source_id")
  amount       Decimal   @db.Decimal(12, 2)
  currency     String    @default("TWD")
  receivedDate DateTime  @map("received_date")
  note         String?
  eventId      String?   @map("event_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  source IncomeSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@map("incomes")
}

model ExpenseCategory {
  id        String              @id @default(cuid())
  userId    String?             @map("user_id")
  name      String
  type      ExpenseCategoryType
  isDefault Boolean             @default(false) @map("is_default")
  createdAt DateTime            @default(now()) @map("created_at")
  updatedAt DateTime            @updatedAt @map("updated_at")

  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  expenses Expense[]

  @@map("expense_categories")
}

model Expense {
  id             String        @id @default(cuid())
  userId         String        @map("user_id")
  categoryId     String?       @map("category_id")
  amount         Decimal       @db.Decimal(12, 2)
  currency       String        @default("TWD")
  expenseDate    DateTime      @map("expense_date")
  paymentMethod  PaymentMethod @map("payment_method")
  sourceModule   String        @default("manual") @map("source_module")
  sourceEntityId String?       @map("source_entity_id")
  note           String?
  eventId        String?       @map("event_id")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  category ExpenseCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@map("expenses")
}

model Budget {
  id                 String   @id @default(cuid())
  userId             String   @map("user_id")
  month              Int
  year               Int
  totalLimit         Decimal  @map("total_limit") @db.Decimal(12, 2)
  currency           String   @default("TWD")
  categoryLimitsJson Json?    @map("category_limits_json")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month, year])
  @@map("budgets")
}

// ─── Goals ───────────────────────────────────────────────────────────────────

model Goal {
  id            String       @id @default(cuid())
  userId        String       @map("user_id")
  goalType      GoalType     @map("goal_type")
  title         String
  targetAmount  Decimal?     @map("target_amount") @db.Decimal(12, 2)
  currentAmount Decimal      @default(0) @map("current_amount") @db.Decimal(12, 2)
  targetDate    DateTime?    @map("target_date")
  priority      GoalPriority @default(MEDIUM)
  status        GoalStatus   @default(ACTIVE)
  metadataJson  Json?        @map("metadata_json")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  milestones GoalMilestone[]
  forecasts  GoalForecast[]

  @@map("goals")
}

model GoalMilestone {
  id           String    @id @default(cuid())
  goalId       String    @map("goal_id")
  userId       String    @map("user_id")
  title        String
  targetAmount Decimal?  @map("target_amount") @db.Decimal(12, 2)
  targetDate   DateTime? @map("target_date")
  isCompleted  Boolean   @default(false) @map("is_completed")
  completedAt  DateTime? @map("completed_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("goal_milestones")
}

model GoalForecast {
  id                    String        @id @default(cuid())
  goalId                String        @map("goal_id")
  userId                String        @map("user_id")
  requiredMonthlySaving Decimal?      @map("required_monthly_saving") @db.Decimal(12, 2)
  currentMonthlySaving  Decimal?      @map("current_monthly_saving") @db.Decimal(12, 2)
  probability           Int
  riskLevel             GoalRiskLevel @map("risk_level")
  forecastDate          DateTime      @default(now()) @map("forecast_date")
  aiReason              String?       @map("ai_reason")
  createdAt             DateTime      @default(now()) @map("created_at")

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("goal_forecasts")
}
