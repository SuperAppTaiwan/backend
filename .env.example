# Server
PORT=3000
NODE_ENV=development

# Database (MongoDB Atlas connection string)
MONGODB_URL=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/ai_survival_os?retryWrites=true&w=majority

# Auth
JWT_SECRET=change-me-in-production-use-a-long-random-string

# CORS — comma-separated list of allowed origins in production (e.g. https://app.example.com,https://admin.example.com)
# Leave blank in development to allow all origins.
CORS_ORIGIN=

# AI — leave blank to use the deterministic fallback provider (no API key needed)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Redis — reserved for future BullMQ queue integration, not yet used by the app
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
